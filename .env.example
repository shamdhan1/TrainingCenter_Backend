# ============================================
# Student Management System - Environment Variables
# Copy this file to .env and update values for your environment
# ============================================

# MySQL Database Configuration
DB_USERNAME=root
DB_PASSWORD=12345

# Individual Database URLs (Database-per-service pattern)
AUTH_DB_URL=jdbc:mysql://localhost:3306/sms_auth_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
ADMIN_DB_URL=jdbc:mysql://localhost:3306/sms_admin_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
TRAINER_DB_URL=jdbc:mysql://localhost:3306/sms_trainer_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
STUDENT_DB_URL=jdbc:mysql://localhost:3306/sms_student_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT Configuration (MUST be same across auth-service and api-gateway)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRY=86400000

# Service Ports
REGISTRY_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8084
ADMIN_PORT=8081
TRAINER_PORT=8082
STUDENT_PORT=8083

# Eureka
EUREKA_URL=http://localhost:8761/eureka/
